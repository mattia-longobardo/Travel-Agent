# --- App ---
TRAVEL_HOST=
TZ=Europe/Rome
SESSION_SECRET=change-me-long-random
# --- Postgres (dedicated) ---
POSTGRES_USER=travel
POSTGRES_DB=travel
DB_TRAVEL_PASSWORD=change-me
# --- Redis (dedicated) ---
# (no password by default; reachable only on travel_internal)
