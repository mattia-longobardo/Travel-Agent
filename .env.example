LASTMINUTE_MCP_URL=https://mcp.lastminute.com/mcp
# --- First admin (bootstrap on startup) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
