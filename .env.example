# --- App ---
TRAVEL_HOST=
TZ=Europe/Rome
SESSION_SECRET=change-me-long-random
# --- PostgreSQL (shared, db stack) ---
POSTGRES_USER=travel
POSTGRES_DB=travel
DB_TRAVEL_PASSWORD=change-me
# --- Redis (shared, db stack, DB index 4) ---
TRAVEL_AGENT_REDIS_PASSWORD=change-me
